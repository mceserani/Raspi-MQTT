{
  "$comment": "Configurazione del server MCP dell'agente (docs/PIANO-AGENTE.md §5.5). I margini rendono i limiti dei comandi più stretti delle soglie dell'interblocco: un setpoint accettato non deve far scattare l'interblocco per il rumore di misura. Tempi in secondi.",

  "commands": {
    "voltageMarginMv": 30,
    "currentMarginPct": 5,
    "temperatureMarginC": 5,
    "temperatureMaxAgeSeconds": 60,
    "batteryMaxAgeSeconds": 10,
    "ackTimeoutSeconds": 10,
    "maxPerMinute": 6
  },

  "status": {
    "maxAgeSeconds": 20,
    "waitSeconds": 5
  },

  "queries": {
    "maxRows": 200,
    "maxCellChars": 300,
    "maxResultChars": 40000
  },

  "summary": {
    "maxBuckets": 500
  },

  "events": {
    "defaultLimit": 50,
    "maxLimit": 200
  },

  "telegram": {
    "maxChars": 3500
  },

  "notes": {
    "maxBytes": 16384
  },

  "reports": {
    "$comment": "Strumento get_report_data. references: valori guida su medie di 24 h (linee guida OMS 2021, µg/m³).",
    "maxDays": 31,
    "maxEventGroups": 15,
    "references": {
      "pm2_5": { "value": 15, "basis": "OMS 2021, media 24 h" },
      "pm10": { "value": 45, "basis": "OMS 2021, media 24 h" }
    }
  },

  "cycles": {
    "$comment": "Strumento get_battery_cycles. maxRestHours: pausa massima tra carica e scarica perché formino un ciclo.",
    "defaultSince": "-30d",
    "maxPhases": 100,
    "maxRestHours": 24
  },

  "launcher": {
    "$comment": "Lanciatore dell'agente (fase 3a). Budget in esecuzioni al giorno (quota dell'abbonamento condivisa): un lavoro Sonnet oltre maxSonnetRunsPerDay passa a Haiku. Tipi di lavoro: modello, numero massimo di turni e strumenti MCP ammessi.",
    "maxRunsPerDay": 10,
    "maxSonnetRunsPerDay": 5,
    "maxQueue": 5,
    "timeoutSeconds": 300,
    "maxPromptChars": 2000,
    "maxReplyChars": 3000,
    "systemPrompt": "Sei l'agente di monitoraggio del laboratorio: segui le istruzioni di CLAUDE.md nella cartella di lavoro. Rispondi in italiano, in testo semplice, senza Markdown. Lavori senza un utente collegato: non chiedere mai conferme o autorizzazioni. Se uno strumento non è disponibile o viene negato, prosegui senza e scrivi il risultato nella risposta finale.",
    "jobs": {
      "ask": {
        "model": "sonnet",
        "maxTurns": 12,
        "tools": ["get_report_data", "get_battery_cycles", "get_live_status", "get_service_health", "get_summary", "get_events", "query_readonly", "read_notes"]
      },
      "triage": {
        "model": "haiku",
        "maxTurns": 10,
        "reserve": 3,
        "tools": ["get_live_status", "get_service_health", "get_summary", "get_events", "read_notes", "write_notes", "send_telegram", "request_escalation"]
      },
      "investigate": {
        "model": "sonnet",
        "maxTurns": 20,
        "reserve": 2,
        "tools": ["get_live_status", "get_battery_cycles", "get_service_health", "get_summary", "get_events", "query_readonly", "read_notes", "write_notes", "send_telegram"]
      },
      "report_daily": {
        "model": "haiku",
        "maxTurns": 10,
        "reserve": 1,
        "tools": ["get_report_data", "get_battery_cycles", "get_live_status", "get_summary", "get_events", "read_notes", "write_notes"]
      },
      "report_weekly": {
        "model": "sonnet",
        "maxTurns": 20,
        "reserve": 1,
        "tools": ["get_report_data", "get_battery_cycles", "get_live_status", "get_service_health", "get_summary", "get_events", "query_readonly", "read_notes", "write_notes"]
      },
      "report": {
        "model": "sonnet",
        "maxTurns": 12,
        "tools": ["get_report_data", "get_battery_cycles", "get_live_status", "get_service_health", "get_summary", "get_events", "query_readonly", "read_notes"]
      },
      "test": {
        "model": "haiku",
        "maxTurns": 4,
        "tools": ["get_live_status"]
      }
    }
  }
}
