# Copia in .env e compila. I valori mostrati sono i default del codice.

# ─── MQTT ───────────────────────────────────────────────────────────
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── MariaDB (servizi esistenti e supervisore) ─────────────────────
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=mceserani
MARIADB_PASSWORD=
MARIADB_DATABASE=sensor_data

# ─── Sensori laboratorio (labsens-mqtt.js) ─────────────────────────
LABSENS_MODBUS_PORT=auto
LABSENS_BAUD_RATE=115200
LABSENS_MODBUS_ADDRESS=29
LABSENS_MODBUS_TIMEOUT=1000
LABSENS_MAX_FAILURES=10
LABSENS_POLL_INTERVAL=1000
LABSENS_DB_TABLE=labsens_measurements

# ─── Batteria (battery-mqtt.js, battery-cmd-bridge.js) ─────────────
BATTERY_MODBUS_PORT=auto
BATTERY_BAUD_RATE=115200
BATTERY_MODBUS_ADDRESS=4
BATTERY_MODBUS_TIMEOUT=1000
BATTERY_MAX_FAILURES=10
BATTERY_POLL_INTERVAL=1000
BATTERY_MQTT_TOPIC=sensors/battery
BATTERY_DB_TABLE=battery_measurements

# ─── Agente: nuovi componenti ──────────────────────────────────────
# Profili di sicurezza batteria (supervisore e server MCP)
BATTERY_PROFILES_FILE=config/battery-profiles.json

# Telegram: token da BotFather e chat_id dell'unico utente autorizzato.
# Solo il supervisore li conosce: l'agente passa sempre da lui.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Utente MariaDB di sola lettura per l'agente (creato da setup-agent-prereqs.sh).
# Sul Pi le credenziali reali stanno in /home/raspi-agent/.config/raspi-agent/agent.env
MARIADB_RO_USER=agent_ro
MARIADB_RO_PASSWORD=
